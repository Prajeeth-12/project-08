# AI Interview Agent — Environment Template
# Copy this file to backend/.env and fill in real values
# NEVER commit backend/.env to git

# ── LLM Provider ──────────────────────────────────────────
COACH_LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# ── Voice (Deepgram STT + TTS) ─────────────────────────────
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_VOICE=aura-2-asteria-en

# ── Database ───────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./project08.db
QUESTION_BANK_DATABASE_URL=your_supabase_pg_url_here

# ── Code Execution (Judge0) ────────────────────────────────
JUDGE0_URL=http://your_judge0_ip:2358
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_AUTH_TOKEN=your_judge0_token_here

# ── Auth ───────────────────────────────────────────────────
USE_MOCK_AUTH=true
SECRET_KEY=change-this-to-any-random-string-for-local-dev

# ── CORS ───────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8086

# ── Supabase ───────────────────────────────────────────────
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# ── Frontend Supabase vars (used by docker-compose build args) ─
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_key

# ── Encryption (optional for local dev) ───────────────────
KMS_KEY_ID=