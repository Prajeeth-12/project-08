# Copy this to backend/.env and fill in your keys
# App runs in mock mode without any keys set (USE_MOCK_AUTH=true)

# ── Auth ───────────────────────────────────────────────────────────────────────
USE_MOCK_AUTH=true
SECRET_KEY=change-me-in-production
# AWS Cognito (only needed when USE_MOCK_AUTH=false)
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/project08.db
QUESTION_BANK_DATABASE_URL=

# ── AI / LLM ───────────────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_VOICE_API_KEY=
GEMINI_VOICE_MODEL=gemini-3.8-live
GEMINI_VOICE_NAME=Aoede

# ── Voice ──────────────────────────────────────────────────────────────────────
DEEPGRAM_API_KEY=
DEEPGRAM_VOICE=aura-2-asteria-en

# ── Supabase (optional) ────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_PUBLISHABLE_KEY=

# ── Code Execution ─────────────────────────────────────────────────────────────
JUDGE0_URL=
JUDGE0_AUTH_TOKEN=
