# LLM / Reasoning Configuration (Summary & Coaching)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL_NAME=gemini-2.5-flash-lite-preview-06-17
SERPER_API_KEY=your_serper_api_key_here

# Primary Real-Time Voice Engine: Amazon Bedrock - Amazon Nova 2 Sonic
# Full-duplex speech-to-speech with natural turn-taking & barge-in interruption
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
AWS_REGION=us-east-1
NOVA_SONIC_MODEL_ID=amazon.nova-2-sonic-v1:0
NOVA_SONIC_VOICE_ID=arjun

# Database & Authentication
SUPABASE_URL=your_supabase_url_here
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# Fallback Batch Speech APIs (Optional)
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here


# Judge0 Configuration
JUDGE0_URL=http://3.109.60.65:2359
JUDGE0_AUTH_HEADER=X-Auth-Token
